{
  "name": "agent-kit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "check": "node scripts/validate-content.mjs",
    "check:staged": "node scripts/validate-content.mjs --staged",
    "test:content": "node --test test/*.test.mjs",
    "build": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "linkedom": "0.18.15",
    "marked": "18.1.3",
    "sanitize-html": "2.18.1",
    "yaml": "2.9.1"
  }
}
